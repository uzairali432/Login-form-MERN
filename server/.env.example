# Server Configuration
PORT=3001

# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/login-form

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/login-form

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-key-change-in-production-12345

# Environment
NODE_ENV=development
